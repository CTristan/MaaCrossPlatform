<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tasks="using:MaaGui.Configuration.Tasks"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="MaaGui.Views.DailyTasks.TaskViews.RecruitTaskView"
             x:DataType="tasks:RecruitTask">
    <StackPanel Spacing="12" Margin="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Max Times:" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding MaxTimes}" Minimum="1" Maximum="10" Width="120"/>
        </StackPanel>
        
        <CheckBox Content="Refresh for 3★" IsChecked="{Binding RefreshLevel3}"/>
        <CheckBox Content="Auto Choose 3★" IsChecked="{Binding Level3Choose}"/>
        <CheckBox Content="Auto Choose 4★" IsChecked="{Binding Level4Choose}"/>
        <CheckBox Content="Auto Choose 5★" IsChecked="{Binding Level5Choose}"/>
    </StackPanel>
</UserControl>
