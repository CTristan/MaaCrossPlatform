<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tasks="using:MaaGui.Configuration.Tasks"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
             x:Class="MaaGui.Views.DailyTasks.TaskViews.CopilotTaskView"
             x:DataType="tasks:CopilotTask">
    <StackPanel Spacing="8" Margin="8">
        <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="JSON File" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding Filename}" Watermark="Path to copilot JSON file"/>
        </Grid>
    </StackPanel>
</UserControl>
