<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tasks="using:MaaGui.Configuration.Tasks"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="MaaGui.Views.DailyTasks.TaskViews.AwardTaskView"
             x:DataType="tasks:AwardTask">
    <StackPanel Spacing="12" Margin="8">
        <CheckBox Content="Daily Mission Award" IsChecked="{Binding Award}"/>
        <CheckBox Content="Mail Award" IsChecked="{Binding Mail}"/>
        <CheckBox Content="Free Gacha" IsChecked="{Binding FreeGacha}"/>
        <CheckBox Content="Orundum Wall" IsChecked="{Binding Orundum}"/>
    </StackPanel>
</UserControl>
